# Copy this file to .env for local development, and add the same names as
# Variables in Railway. Never commit .env or paste real values anywhere public.

# --- Required ---------------------------------------------------------------
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/plotpost?retryWrites=true&w=majority
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server -----------------------------------------------------------------
# Railway sets PORT itself; 5000 is used locally.
PORT=5000
# Set to production on Railway.
NODE_ENV=development
# Browser sites allowed to call the API, comma-separated (the mobile app
# doesn't need to be listed). Example: https://plotpost-xxxx.web.app
CORS_ORIGINS=

# --- Sessions (defaults are fine) ---------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# --- Cloudinary (photos) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (verification and password reset codes) ----------------------------
# Google Workspace / Gmail: host smtp.gmail.com, port 465, user = the full
# address, pass = an App Password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender shown to users, e.g. PlotPost <no-reply@yourdomain.com>
EMAIL_FROM=
# Local testing without SMTP: print codes in the terminal. Never on Railway.
EMAIL_DEV_LOG_CODES=false

# --- Google sign-in -----------------------------------------------------------
# OAuth client IDs from Google Cloud Console, comma-separated. The Web client
# ID is required (the Android app sends tokens issued for it).
GOOGLE_CLIENT_IDS=

# --- Rate limiting (defaults are fine) ----------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# --- Local Windows only -------------------------------------------------------
# Public DNS servers used for the mongodb+srv lookup (fixes querySrv
# ECONNREFUSED on some networks). Leave empty on Railway.
# DNS_SERVERS=1.1.1.1,8.8.8.8
